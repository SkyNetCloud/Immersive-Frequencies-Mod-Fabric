{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "${mod_group_id}.${mod_id}.MainEZ"
    ],
    "client": [
      "${mod_group_id}.${mod_id}.client.ClientMainEZ"
    ],
    "voicechat": [
      "${mod_group_id}.${mod_id}.Plugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "voicechat": ">=${voicechat_version}",
    "minecraft": "${minecraft_version}",
    "geckolib": ">=${geckolib_version}"
  },
  "suggests": {
    "accessories": "*"
  }
}